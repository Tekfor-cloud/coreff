<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="axesor_captive_form" model="ir.ui.view">
        <field name="name">axesor.captive.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <group name="coreff_core_fields" position="after">
                <field name="axesor_visibility" invisible="1"/>
                <group string="Axesor" attrs="{'invisible': [('axesor_visibility', '=', False)]}">
                    <field name="axesor_login" required="1" />
                    <field name="axesor_password" password="1" required="1" />
                </group>
            </group>
        </field>
    </record>

</odoo>