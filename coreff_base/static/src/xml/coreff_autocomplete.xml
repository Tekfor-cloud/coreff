<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="coreff_base.PartnerAutoCompleteCharField" t-inherit="web.CharField" owl="1">
        <xpath expr="//t[@t-else='']" position="before">
            <t t-elif="props.record.resModel !== 'res.partner' || props.record.data.company_type === 'company'">
                <CoreffAutoComplete value="props.value || ''" sources="sources" onSelect.bind="onSelect"
                    input="inputRef" placeholder="props.placeholder || ''"
                    onHeadOfficeCheck="(checked) => this.state.headOffice = checked"/>
            </t>
        </xpath>
    </t>

    <t t-name="coreff_base.CharFieldDropdownOption" owl="1">
        <div class="o_coreff_base_info">
            <strong t-esc="option.name or '&#160;'"/>
            <div t-esc="option.coreff_company_code"/>
            <div t-esc="option.city"/>
        </div>
    </t>

    <t t-name="coreff_base.AutoComplete" t-inherit="web.AutoComplete" owl="1">
        <xpath expr="//ul/*[1]" position="before">
            <li>
                <input id="head_office_checkbox" type="checkbox" t-att-checked="state.headOffice ? 'checked' : ''"
                    t-on-change="onUpdateHeadOffice"/>
                <label for="head_office_checkbox">Head-Office</label>
            </li>
        </xpath>
    </t>

    <t t-name="coreff_base.InsufficientCreditNotification" owl="1">
        <div class="o-hidden-ios">
            <a class="btn btn-link" t-att-href="credits_url"><i class="fa fa-arrow-right"/> Buy more credits</a>
        </div>
    </t>

    <t t-name="coreff_base.AccountTokenMissingNotification" owl="1">
        <div class="">
            <a class="btn btn-link" t-att-href="account_url"><i class="fa fa-arrow-right"/> Set Your Account Token</a>
        </div>
    </t>
</templates>