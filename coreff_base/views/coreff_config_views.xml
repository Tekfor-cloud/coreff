<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_coreff_config" model="ir.ui.view">
    <field name="name">Coreff: Configuration</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="5"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">

      <xpath expr="//form" position="inside">
        <div class="app_settings_block" data-string="coreff" string="Coreff" data-key="coreff_base"
          groups="coreff_base.group_coreff_app_admin" id="coreff_settings_block">
          <h2>Coreff</h2>

          <div class="row mt16 o_settings_container">
            <div class="col-12 col-lg-6 o_setting_box" id="coreff_societecom_config">
              <div class="o_setting_left_pane">
                <field name="module_coreff_societecom"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="module_coreff_societecom"/>
                <div class="text-muted"> Enable the retrieving of corporate data for companies using Societe.com </div>
              </div>
            </div>
            <div class="col-12 col-lg-6 o_setting_box" id="coreff_creditsafe_config">
              <div class="o_setting_left_pane">
                <field name="module_coreff_creditsafe"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="module_coreff_creditsafe"/>
                <div class="text-muted"> Enable the retrieving of corporate data for companies using Credit Safe
                  services </div>
              </div>
            </div>
            <div class="col-12 col-lg-6 o_setting_box" id="coreff_informa_config">
              <div class="o_setting_left_pane">
                <field name="module_coreff_informa"/>
              </div>
              <div class="o_setting_right_pane">
                <label for="module_coreff_informa"/>
                <div class="text-muted"> Enable the retrieving of corporate data for companies using Informa services </div>
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>

</odoo>