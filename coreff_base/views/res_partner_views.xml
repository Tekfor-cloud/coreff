<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="coreff_partner_form">
    <field name="name">coreff.partner.form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('oe_title')]" position="after">
        <p id="alert_coreff" class="alert alert-warning" role="alert" style="display: none;"/>
      </xpath>

      <xpath expr="//field[@id='company']" position="attributes">
        <attribute name="widget">field_coreff_autocomplete</attribute>
        <attribute name="options">{'headOffice': True}</attribute>
      </xpath>

      <xpath expr="//field[@name='name']/.." position="after">
        <h2>
          <field name="coreff_company_code_mandatory" invisible="1"/>
          <field name="coreff_company_code" widget="field_coreff_autocomplete" options="{'headOffice': True}"
            placeholder="Company code" invisible="not is_company"
            required="is_company and coreff_company_code_mandatory"/>
        </h2>
      </xpath>

      <xpath expr="//field[@name='lang']" position="before">
        <field name="coreff_activity_code"/>
      </xpath>

    </field>
  </record>

</odoo>